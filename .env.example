# Copy this file to .env.local (development) or configure these as
# environment variables in your deployment platform (e.g. Vercel).
# Never commit real secrets — this file only documents variable names.

# --- Database -----------------------------------------------------------
# PostgreSQL connection string used by Prisma.
DATABASE_URL=""

# --- Auth (wired up in Step 2) ------------------------------------------
# Random 32+ byte secret used to sign session tokens. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=""

# --- Tenant / site configuration -----------------------------------------
# Canonical site URL, used for metadata (OpenGraph, canonical links).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Public (client-visible) values for the active hotel. See src/config/site.ts.
# Safe defaults are used when these are unset, so the app runs without them.
NEXT_PUBLIC_HOTEL_NAME="Royal Horizon Hotel"
NEXT_PUBLIC_HOTEL_TAGLINE="The city, from a quieter altitude"
NEXT_PUBLIC_HOTEL_DESCRIPTION="A modern hotel above the harbor district — considered rooms, unhurried service, and a skyline that earns the view."
NEXT_PUBLIC_HOTEL_PHONE="+1 (555) 042-8800"
NEXT_PUBLIC_HOTEL_EMAIL="stay@royalhorizon.example"
NEXT_PUBLIC_HOTEL_ADDRESS="1 Horizon Quay, Harborview, Portside"
# WhatsApp number in international format, digits only (no + or spaces),
# e.g. "15550428800". Leave unset to show the safe fallback CTA.
NEXT_PUBLIC_HOTEL_WHATSAPP=""
NEXT_PUBLIC_HOTEL_INSTAGRAM=""
NEXT_PUBLIC_HOTEL_FACEBOOK=""
NEXT_PUBLIC_DEFAULT_LOCALE="en-US"
NEXT_PUBLIC_DEFAULT_CURRENCY="USD"
NEXT_PUBLIC_DEFAULT_TIMEZONE="America/New_York"

# --- Payments (wired up when the booking engine ships) -------------------
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# --- Notifications (wired up with automation handlers) -------------------
# RESEND_API_KEY=""
# WHATSAPP_BUSINESS_TOKEN=""
